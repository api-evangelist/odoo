            "name": "XML-RPC object endpoint (execute_kw on Odoo models)",
            "description": {
              "content": "Accepts authenticated XML-RPC `execute_kw` calls with positional\narguments (db, uid, password/api-key, model, method, args, kwargs).\nSupported model methods include `search`, `search_count`, `read`,\n`search_read`, `fields_get`, `create`, `write`, and `unlink`.\n",
              "type": "text/plain"
            },
